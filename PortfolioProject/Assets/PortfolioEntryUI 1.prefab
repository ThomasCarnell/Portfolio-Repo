  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<Desription In May 2019 I was blown away by RIOT CITY 's first record
    on the *Only youtube channel that matters* - since then I co-founded Crucible
    Speed Metal with Jon Brog\xE5rd and today our first record is available there,
    through From The Vaults. In the words of Phil Campbell \"it should feel like
    a sh!t after a curry\". It feels like a solid stab at contributing to the current
    wave of traditional heavy metal and I'm proud of that- and lucky to have a hell
    of a band that all blew it out of the water in Death Island Studio, Kenneth Frandsen
    Philip Butler & Ole Iversen.\r\nSo give it a listen and go forth and HAIL TO
    THE FORCE!>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
